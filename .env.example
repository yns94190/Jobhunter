# Application
APP_VERSION=0.1.0
DATABASE_URL=sqlite:///./data/jobhunter.db
LOG_LEVEL=INFO

# France Travail (J2)
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# Adzuna (J3)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# IMAP (J4)
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=

# Anthropic (J5)
ANTHROPIC_API_KEY=

# SMTP (J6)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Authentification (laisser vide en local, obligatoire en ligne)
AUTH_USER=yanis
AUTH_PASSWORD=

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_HOURS=3
